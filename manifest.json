{
  "manifest_version": 3,
  "name": "每日成长 Daily Growth",
  "version": "1.0.0",
  "description": "简洁美观的每日习惯打卡助手，记录点滴成长。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "每日成长",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
